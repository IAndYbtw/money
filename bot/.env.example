# Обязательные
BOT_TOKEN=1234567890:AA...your_token

# Ключ ИИ-провайдера. Нужен для /insights, /ask и сводок; без него бот
# запускается, но команды ИИ отвечают ошибкой. Для Ollama подойдёт "ollama".
AI_API_KEY=sk-...your_api_key

# Провайдер ИИ: любой OpenAI-совместимый endpoint.
# По умолчанию — DeepSeek.
AI_MODEL=deepseek-chat
AI_BASE_URL=https://api.deepseek.com
AI_TIMEOUT=30
AI_RETRIES=2

# --- Бесплатные варианты (раскомментируй нужный блок) -----------------------
#
# Google Gemini (бесплатный тариф, карта не нужна, лимиты видны в AI Studio):
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODEL=gemini-3.8-flash
#
# Groq (бесплатный тариф, очень быстро):
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-120b
#
# OpenRouter (модели с суффиксом :free, 50 запросов в день до $10 пополнения):
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
# Ollama локально (полностью бесплатно, нужна установка и RAM):
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=qwen3:8b
# AI_API_KEY=ollama

# Устаревшие имена DeepSeek_* по-прежнему поддерживаются как алиасы.
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# База (относительный путь считается от каталога bot/)
DB_PATH=finbot.sqlite3

# Локализация и напоминания
DEFAULT_TIMEZONE=Europe/Moscow
DEFAULT_REMINDER_TIME=09:00

# Не больше N запросов к ИИ на пользователя в сутки (0 = без лимита)
AI_DAILY_LIMIT=30

# Публичный HTTPS-адрес Mini App. Пока не задан — кнопка не показывается.
# WEB_APP_URL=https://example.com/app

# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
